# visual-studio configuration.
# All variables are OPTIONAL; sensible offline defaults are applied when unset.
# Copy this file to `.env` to override. The default wiring runs fully OFFLINE
# with the MockProvider (no GPU, no network, no docker required).

# SQLite database file path (self-initializing schema on first run).
VISUAL_DB_PATH=data/visual_studio.db

# Directory where generated artifacts (real .svg files) are written.
VISUAL_OUTPUT_DIR=outputs

# Default provider name when an image_type is not found in the route map.
# One of: mock (default, fully functional) | dashscope (real, needs a key)
#         | seedream | gpt_image (structured stubs)
VISUAL_PROVIDER=mock

# JSON map of image_type -> provider name. The default routes everything to the
# mock provider so the service runs offline.
#
# Real text-to-image (Alibaba DashScope / 百炼):
#   VISUAL_PROVIDER=dashscope
#   VISUAL_PROVIDER_ROUTE={"main":"dashscope","scene":"dashscope","detail":"dashscope"}
#   VISUAL_DASHSCOPE_API_KEY=sk-xxxx
#   VISUAL_IMAGE_MODEL=qwen-image-3.0
# Note: ~50s per image, billed per image. Project B generates a batch
# serially, so raise LISTING_VISUAL_TIMEOUT on side A to ~900s.
VISUAL_PROVIDER_ROUTE={"main":"mock","scene":"mock","detail":"mock"}

# -- real provider: Alibaba DashScope (used only when routed above) ----------
VISUAL_DASHSCOPE_API_KEY=
VISUAL_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
VISUAL_IMAGE_MODEL=qwen-image-3.0
VISUAL_IMAGE_TIMEOUT=180

# If set, every emitted event is POSTed as JSON to this URL (best-effort).
# Leave empty to disable webhook delivery (no network calls).
VISUAL_WEBHOOK_URL=

# HTTP server bind host/port.
VISUAL_HOST=0.0.0.0
VISUAL_PORT=8011
